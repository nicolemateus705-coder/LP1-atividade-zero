#include <iostream>
using namespace std;

int main() {
    int numero;
    bool primo = true;

    cout << "Digite um numero inteiro: ";
    cin >> numero;

    if (numero <= 1) {
        primo = false;
    }
    else {
        for (int i = 2; i < numero; i++) {
            if (numero % i == 0) {
                primo = false;
                break;
            }
        }
    }

    if (primo) {
        cout << numero << " e um numero primo." << endl;
    }
    else {
        cout << numero << " nao e um numero primo." << endl;
    }

    return 0;
}
