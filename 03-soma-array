#include <iostream>
using namespace std;

int main() {
    int numeros[5];
    int soma = 0;

    cout << "Digite 5 numeros inteiros:" << endl;

    for (int i = 0; i < 5; i++) {
        cin >> numeros[i];
        soma = soma + numeros[i];
    }

    cout << "A soma dos numeros e: " << soma << endl;

    return 0;
}
