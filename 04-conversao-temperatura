#include <iostream>
using namespace std;

int main() {
    double temperatura;
    int opcao;

    cout << "Digite 1 para converter Celsius para Fahrenheit." << endl;
    cout << "Digite 2 para converter Fahrenheit para Celsius." << endl;
    cout << "Escolha uma opcao: ";
    cin >> opcao;

    cout << "Digite a temperatura: ";
    cin >> temperatura;

    if (opcao == 1) {
        double fahrenheit;

        fahrenheit = (temperatura * 9 / 5) + 32;

        cout << "Temperatura em Fahrenheit: " << fahrenheit << endl;
    }
    else if (opcao == 2) {
        double celsius;

        celsius = (temperatura - 32) * 5 / 9;

        cout << "Temperatura em Celsius: " << celsius << endl;
    }
    else {
        cout << "Opcao invalida." << endl;
    }

    return 0;
}
