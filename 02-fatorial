#include <iostream>
using namespace std;

int main() {
    int numero;
    long long fatorial = 1;

    cout << "Digite um numero inteiro: ";
    cin >> numero;

    for (int i = 1; i <= numero; i++) {
        fatorial = fatorial * i;
    }

    cout << "O fatorial de " << numero << " e: " << fatorial << endl;

    return 0;
}
